# Copy this file to .env in the same folder (backend/ root) and adjust if needed.
# .env should be in .gitignore - never commit real credentials.

POSTGRES_DB=techdept
POSTGRES_USER=techdept
POSTGRES_PASSWORD=techdept

# Used by the Spring Boot app (application.yml) when running via ./mvnw
# Must match the POSTGRES_* values above.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/techdept
SPRING_DATASOURCE_USERNAME=techdept
SPRING_DATASOURCE_PASSWORD=techdept
